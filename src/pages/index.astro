---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Metric from '../components/Metric.astro';

const projects = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const capabilities = (await getCollection('capabilities')).sort((a, b) => a.data.order - b.data.order);
const certifications = (await getCollection('certifications')).sort((a, b) => a.data.order - b.data.order);
const featuredCertifications = certifications.filter((certification) => certification.data.featured);
const homeEntry = await getEntry('homePage', 'home');
if (!homeEntry) throw new Error('Missing src/content/pages/home.md');
if (featuredCertifications.length === 0) throw new Error('Mark at least one certification as featured: true');
const home = homeEntry.data;
---

<BaseLayout>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href="/tahina-polished-960.webp"
      imagesrcset="/tahina-polished-640.webp 640w, /tahina-polished-960.webp 960w, /tahina-polished.webp 1254w"
      imagesizes="(max-width: 560px) calc(100vw - 32px), (max-width: 900px) 520px, 363px"
      fetchpriority="high"
      type="image/webp"
    />
  </Fragment>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="kicker">{home.heroKicker}</p>
        <h1>{home.headlineFirst}<br /><span>{home.headlineAccent}</span></h1>
        <p class="hero-intro">{home.introduction}</p>
        <div class="hero-actions">
          <a class="button button-primary" href={home.primaryAction.href}>{home.primaryAction.label}</a>
          <a class="button button-secondary" href={home.secondaryAction.href}>{home.secondaryAction.label}</a>
        </div>
      </div>
      <div class="hero-portrait" aria-label={home.portraitAlt}>
        <img
          src="/tahina-polished-960.webp"
          srcset="/tahina-polished-640.webp 640w, /tahina-polished-960.webp 960w, /tahina-polished.webp 1254w"
          sizes="(max-width: 560px) calc(100vw - 32px), (max-width: 900px) 520px, 363px"
          alt={home.portraitAlt}
          width="960"
          height="960"
          loading="eager"
          fetchpriority="high"
        />
        <div class="status-card">
          <span class="status-dot" aria-hidden="true"></span>
          <div><strong>{home.statusTitle}</strong><small>{home.statusText}</small></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-compact" aria-label={home.metricsLabel}>
    <div class="shell metric-grid">
      {home.metrics.map((metric) => <Metric value={metric.value} label={metric.label} />)}
    </div>
  </section>

  <section class="section section-soft">
    <div class="shell">
      <div class="section-heading split-heading">
        <div>
          <p class="kicker">{home.projectsKicker}</p>
          <h2>{home.projectsTitle}</h2>
        </div>
        <p>{home.projectsIntroduction}</p>
      </div>
      <div class="project-grid">
        {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
      </div>
      <div class="section-cta"><a class="button button-secondary" href="/projects/">{home.projectsButtonLabel}</a></div>
    </div>
  </section>

  <section class="section section-light">
    <div class="shell expertise-grid">
      <div class="section-heading sticky-heading">
        <p class="kicker">{home.capabilitiesKicker}</p>
        <h2>{home.capabilitiesTitle}</h2>
        <p>{home.capabilitiesIntroduction}</p>
      </div>
      <div class="capability-list">
        {capabilities.map((capability, index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div><h3>{capability.data.title}</h3><p>{capability.data.summary}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section certification-band">
    <div class="shell">
      <div class="certification-heading">
        <p class="kicker">{home.certificationKicker}</p>
      </div>
      <div class="certification-grid">
        {featuredCertifications.map((certification) => (
          <article class="certification-card">
            {certification.data.image ? (
              <div class="cert-mark cert-mark-image">
                <img
                  src={certification.data.image}
                  alt={certification.data.imageAlt ?? `${certification.data.title} credential badge`}
                  width="280"
                  height="280"
                  loading="lazy"
                />
              </div>
            ) : (
              <div class="cert-mark" aria-hidden="true">{certification.data.code}</div>
            )}
            <div class="certification-card-copy">
              <p class="certification-issuer">{certification.data.credentialType} · {certification.data.issuer}</p>
              <h2>{certification.data.title}</h2>
              <p>{certification.data.summary}</p>
              <a class="text-link" href={certification.data.verifyUrl} target="_blank" rel="noreferrer">{certification.data.verifyLabel}</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
